# ==============================================================================
# NorthWay CRM - Environment Configuration Example
# Copie este arquivo para .env e preencha com seus valores locais / de produção.
# NUNCA comite arquivos .env contendo credenciais reais no repositório.
# ==============================================================================

# --- BANCO DE DADOS & FLASK ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/northway_crm
SECRET_KEY=substitua-por-um-secret-key-forte-e-aleatorio
FLASK_ENV=development
FLASK_DEBUG=1

# --- SEGURANÇA & OPERAÇÕES CRÍTICAS ---
# ALLOW_SYSTEM_RESET=1 é OBRIGATÓRIO para executar o comando CLI 'flask system-reset'
ALLOW_SYSTEM_RESET=0
# Segredo usado para criptografia simétrica (Fernet) de credenciais de terceiros no banco
CRM_ENCRYPTION_SECRET=substitua-por-um-segredo-de-criptografia-forte

# --- AUTENTICAÇÃO INTERNA & CRON ---
# Bearer token obrigatório para chamadas em /tenant/* e /prospecting/* via n8n / serviços internos
CRM_INTERNAL_API_KEY=seu-crm-internal-api-key
# Bearer token obrigatório para endpoints acionados por cron jobs em /api/cron/*
CRON_SECRET=seu-cron-secret-token

# --- GATEWAY DE PAGAMENTOS (ASAAS) ---
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=$aact_substitua_pelo_token_api_asaas
# Token configurado no webhook do painel Asaas para validação em /billing/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=seu-token-de-webhook-asaas

# --- WHATSAPP (EVOLUTION API) ---
EVOLUTION_API_URL=https://api.suainstancia.com
EVOLUTION_API_KEY=sua-api-key-evolution
# Token configurado no webhook da Evolution API para validação em /api/webhooks/evolution
EVOLUTION_WEBHOOK_TOKEN=seu-token-de-webhook-evolution

# --- SUPABASE (OPCIONAL / MIGRAÇÃO) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-supabase-service-role-key

# --- GOOGLE WORKSPACE / DRIVE (OPCIONAL) ---
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback

# --- INTEGRAÇÕES AUXILIARES ---
NORA_WEBHOOK_URL=https://n8n.seuhost.com/webhook/nora-ai

# --- SCRIPTS DE MANUTENÇÃO (CLI / SCRIPTS) ---
# Usado apenas por scripts manuais em scripts/ e maintenance/
MASTER_EMAIL=master@northway.com
MASTER_PASSWORD=senha-temporaria-forte-master
