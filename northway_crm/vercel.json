{
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "rewrites": [
        {
            "source": "/formularios(.*)",
            "destination": "https://northway-crm-next.vercel.app/formularios$1"
        },
        {
            "source": "/api/forms(.*)",
            "destination": "https://northway-crm-next.vercel.app/api/forms$1"
        },
        {
            "source": "/_next(.*)",
            "destination": "https://northway-crm-next.vercel.app/_next$1"
        }
    ]
}