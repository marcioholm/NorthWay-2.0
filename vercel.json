{
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/lp-north-way/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/webhook-deliveries",
            "schedule": "* * * * *"
        },
        {
            "path": "/api/cron/prospecting-batch-processor",
            "schedule": "*/2 * * * *"
        },
        {
            "path": "/api/cron/prospecting-scheduler",
            "schedule": "*/10 * * * *"
        },
        {
            "path": "/api/cron/drive-sync",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/cron/task-reminders",
            "schedule": "*/15 * * * *"
        }
    ]
}