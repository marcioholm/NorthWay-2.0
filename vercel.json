{
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        },
        {
            "src": "lp-north-way/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/lp-north-way/static/$1"
        },
        {
            "src": "/live",
            "dest": "/lp-north-way/live.html"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ]
}